# Environment variables for the tools-website API service
# this file should live at tools_website/api/config/tools-website.env
# it does not get checked into source control 

PORT=4000
CORS_ORIGIN=http://localhost:8088
COOKIE_NAME=garden_hub_session
COOKIE_SECURE=false
SESSION_TTL_HOURS=24
DB_FILE=/data/tools-website.db

# Optional bootstrap admin creation at startup (one-time use):
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-now

MQTT_URL=mqtt://mosquitto:1883
MQTT_CLIENT_ID=garden-hub-tools-api
MQTT_ALLOWED_TOPICS=house/#
MQTT_DEFAULT_QOS=0
MQTT_DEFAULT_RETAIN=false
MAX_PAYLOAD_BYTES=4096
