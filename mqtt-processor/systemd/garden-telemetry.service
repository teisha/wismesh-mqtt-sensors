[Unit]
Description=Garden telemetry MQTT bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{SERVICE_USER}}
Group={{SERVICE_GROUP}}
WorkingDirectory={{APP_DIR}}
EnvironmentFile=-/etc/default/garden-telemetry
ExecStart={{VENV_PYTHON}} {{APP_PY}}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
